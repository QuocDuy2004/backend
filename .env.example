NODE_ENV=production

# App – điền URL thật sau khi deploy lên Render
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
EXTRA_CORS_ORIGINS=

# API base URL cho frontend.
# Để trống = /api cùng domain.
# Có thể set domain gốc: VITE_API_BASE_URL=https://localhost:3000
# Hoặc set đầy đủ: VITE_API_BASE_URL=https://localhost:3000/api
VITE_API_BASE_URL=

# JWT
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Database – Aiven MySQL free tier (aiven.io → MySQL service → Overview)
DB_HOST=mysql-xxx.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=
DB_DATABASE=defaultdb
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Gemini AI
GEMINI_API_KEY=

# VNPay (VNPAY_RETURN_URL tự build từ APP_URL nếu để trống)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=

# MoMo (MOMO_RETURN_URL, MOMO_IPN_URL tự build từ APP_URL nếu để trống)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=
MOMO_IPN_URL=
