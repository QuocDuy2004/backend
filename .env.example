# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Runtime.
NODE_ENV="development"
PORT="3000"

# MySQL database connection.
# Copy this file to .env.local on your machine/server and update values there.
# .env.local is intentionally ignored by Git, so GitHub keeps the connection template but not your password.
# Create/import with: npm run db:init
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_DATABASE="demo"
DB_CONNECTION_LIMIT="10"

# JWT auth.
# Use a long random value in production.
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# SMMKay listOrder sync.
SMMKAY_API_URL="https://smmkay.com/api/adminv1"
SMMKAY_API_KEY="YOUR_API_KEY_HERE"
SMMKAY_SERVICE_ID="1944"

# Google Sheet sync.
# Share the spreadsheet with GOOGLE_CLIENT_EMAIL before running sync.
GOOGLE_SPREADSHEET_ID="1a1RbH5pvRwDF_mUrwcJWDTwcR3XCJv8fh3Pmy8-VtdM"
GOOGLE_SHEET_GID="1590614847"
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# VNPay Configuration
VNPAY_TMN_CODE="YOUR_TMN_CODE"
VNPAY_HASH_SECRET="YOUR_HASH_SECRET"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payments/vnpay/return"

# MoMo Configuration
MOMO_PARTNER_CODE="YOUR_PARTNER_CODE"
MOMO_ACCESS_KEY="YOUR_ACCESS_KEY"
MOMO_SECRET_KEY="YOUR_SECRET_KEY"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_RETURN_URL="http://localhost:3000/api/payments/momo/return"
MOMO_IPN_URL="http://localhost:3000/api/payments/momo/ipn"

# Frontend URL for redirects
FRONTEND_URL="http://localhost:8081"
