# Runtime
# Local: development
# Vercel production: production
NODE_ENV=production

# Public app URLs
# After Vercel deploy, set both to your production domain.
# Example:
# APP_URL=https://backend-five-five.vercel.app
# FRONTEND_URL=https://frontend-ten-gamma-17.vercel.app
APP_URL=https://backend-5nxv.vercel.app
FRONTEND_URL=https://frontend-ten-gamma-17.vercel.app
EXTRA_CORS_ORIGINS=https://frontend-ten-gamma-17.vercel.app

# Frontend API base URL
# Leave empty when frontend and API are on the same Vercel domain.
# If API is hosted separately, set either:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=

# Auth
# Use a random string with at least 32 characters in production.
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# MySQL
# You can either fill the split variables below, or set DATABASE_URL / MYSQL_PUBLIC_URL.
# Railway gives a ready-made URL in Variables -> MYSQL_PUBLIC_URL.
# For Aiven or most cloud MySQL providers, keep DB_SSL=true.
DATABASE_URL=
DB_HOST=mysql-xxx.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=change-this-password
DB_DATABASE=defaultdb
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Gemini AI
GEMINI_API_KEY=

# VNPay
# VNPAY_RETURN_URL can be empty; the server builds it from APP_URL.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=

# MoMo
# MOMO_RETURN_URL and MOMO_IPN_URL can be empty; the server builds them from APP_URL.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=
MOMO_IPN_URL=
